rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny all reads and writes by default
    match /{document=**} {
      allow read, write: if false;
    }

    // --- GLOBAL HARDENED HELPERS ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\.]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- VALIDATION BLUEPRINTS (ANTI-UPDATE-GAP) ---
    function isValidUserProfile(data, userId) {
      return data.userId is string && data.userId == userId &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
        (!('email' in data) || data.email == null || (data.email is string && data.email.size() <= 120)) &&
        (!('photoUrl' in data) || data.photoUrl == null || (data.photoUrl is string && data.photoUrl.size() <= 500)) &&
        (!('studyMantra' in data) || data.studyMantra == null || (data.studyMantra is string && data.studyMantra.size() <= 140)) &&
        data.curriculumYear is int && data.curriculumYear >= 1 && data.curriculumYear <= 5 &&
        data.createdAt is timestamp && data.createdAt <= request.time &&
        data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidPersonalBook(data, userId, bookId) {
      return data.userId is string && data.userId == userId &&
        data.bookId is string && data.bookId == bookId && data.bookId.size() >= 1 && data.bookId.size() <= 128 &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 240 &&
        data.author is string && data.author.size() <= 180 &&
        data.subjectKey is string && data.subjectKey.size() >= 1 && data.subjectKey.size() <= 40 &&
        data.courseCode is string && data.courseCode.size() <= 32 &&
        (!('coverUrl' in data) || data.coverUrl == null || (data.coverUrl is string && data.coverUrl.size() <= 500)) &&
        data.coverArtKey is string && data.coverArtKey.size() >= 1 && data.coverArtKey.size() <= 40 &&
        data.totalPages is int && data.totalPages >= 0 && data.totalPages <= 50000 &&
        data.currentPage is int && data.currentPage >= 1 && data.currentPage <= 50000 &&
        data.bookmarked is bool &&
        data.completed is bool &&
        data.lastOpenedAt is int && data.lastOpenedAt >= 0 &&
        data.createdAt is timestamp && data.createdAt <= request.time &&
        data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidStudyNote(data, userId) {
      return data.userId is string && data.userId == userId &&
        data.bookId is string && data.bookId.size() >= 1 && data.bookId.size() <= 128 &&
        data.bookTitle is string && data.bookTitle.size() >= 1 && data.bookTitle.size() <= 240 &&
        data.pageNumber is int && data.pageNumber >= 1 && data.pageNumber <= 50000 &&
        data.chapterTitle is string && data.chapterTitle.size() <= 180 &&
        data.noteText is string && data.noteText.size() <= 2000 &&
        data.createdAt is timestamp && data.createdAt <= request.time &&
        data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    // --- USER PROFILE (STRICT OWNER-ONLY PII ISOLATION) ---
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;

      allow create: if isOwner(userId) &&
        isValidId(userId) &&
        incoming().keys().hasAll(['userId', 'displayName', 'curriculumYear', 'createdAt', 'updatedAt']) &&
        incoming().keys().hasOnly([
          'userId', 'displayName', 'email', 'photoUrl', 'studyMantra',
          'curriculumYear', 'createdAt', 'updatedAt'
        ]) &&
        isValidUserProfile(incoming(), userId);

      allow update: if isOwner(userId) &&
        isValidId(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'email', 'photoUrl', 'studyMantra', 'curriculumYear', 'updatedAt'
        ]);

      allow delete: if isOwner(userId) && isValidId(userId);

      // --- PERSONAL BOOKMARKED LIBRARY & READING PROGRESS ---
      match /personal_books/{bookId} {
        allow get: if isOwner(userId) && isValidId(bookId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
          isValidId(bookId) &&
          incoming().keys().hasAll([
            'userId', 'bookId', 'title', 'author', 'subjectKey', 'courseCode',
            'coverArtKey', 'totalPages', 'currentPage', 'bookmarked', 'completed',
            'lastOpenedAt', 'createdAt', 'updatedAt'
          ]) &&
          incoming().keys().hasOnly([
            'userId', 'bookId', 'title', 'author', 'subjectKey', 'courseCode',
            'coverUrl', 'coverArtKey', 'totalPages', 'currentPage', 'bookmarked',
            'completed', 'lastOpenedAt', 'createdAt', 'updatedAt'
          ]) &&
          isValidPersonalBook(incoming(), userId, bookId);

        allow update: if isOwner(userId) &&
          isValidId(bookId) &&
          isValidPersonalBook(incoming(), userId, bookId) &&
          incoming().userId == existing().userId &&
          incoming().bookId == existing().bookId &&
          incoming().createdAt == existing().createdAt &&
          (
            incoming().diff(existing()).affectedKeys().hasOnly([
              'currentPage', 'totalPages', 'lastOpenedAt', 'updatedAt'
            ]) ||
            incoming().diff(existing()).affectedKeys().hasOnly([
              'bookmarked', 'completed', 'updatedAt'
            ]) ||
            incoming().diff(existing()).affectedKeys().hasOnly([
              'title', 'author', 'subjectKey', 'courseCode', 'coverUrl', 'coverArtKey',
              'totalPages', 'currentPage', 'bookmarked', 'completed', 'lastOpenedAt', 'updatedAt'
            ])
          );

        allow delete: if isOwner(userId) && isValidId(bookId);
      }

      // --- CLOUD-SYNCED PAGE BOOKMARKS & STUDY NOTES ---
      match /study_notes/{noteId} {
        allow get: if isOwner(userId) && isValidId(noteId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
          isValidId(noteId) &&
          incoming().keys().hasAll([
            'userId', 'bookId', 'bookTitle', 'pageNumber',
            'chapterTitle', 'noteText', 'createdAt', 'updatedAt'
          ]) &&
          incoming().keys().hasOnly([
            'userId', 'bookId', 'bookTitle', 'pageNumber',
            'chapterTitle', 'noteText', 'createdAt', 'updatedAt'
          ]) &&
          isValidStudyNote(incoming(), userId);

        allow update: if isOwner(userId) &&
          isValidId(noteId) &&
          isValidStudyNote(incoming(), userId) &&
          incoming().userId == existing().userId &&
          incoming().bookId == existing().bookId &&
          incoming().createdAt == existing().createdAt &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'bookTitle', 'pageNumber', 'chapterTitle', 'noteText', 'updatedAt'
          ]);

        allow delete: if isOwner(userId) && isValidId(noteId);
      }
    }
  }
}
